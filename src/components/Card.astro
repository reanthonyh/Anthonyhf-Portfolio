---
interface Props {
  href?: string | null;
  hover?: boolean;
}

const { href, hover = true } = Astro.props;

const base =
  "bg-umbrella-surface border border-umbrella-line p-5 transition-colors";
const interactive = hover
  ? "hover:border-umbrella-green/60 hover:bg-white/5 group"
  : "";
---

{href ? (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class={`${base} ${interactive} block`}
  >
    <slot />
  </a>
) : (
  <div class={`${base} ${interactive}`}>
    <slot />
  </div>
)}
