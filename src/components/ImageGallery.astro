---
import { Image } from "astro:assets";

interface Props {
  images: string[];
  mainImageIndex?: number;
  showThumbnails?: boolean;
  thumbnailCount?: number;
  className?: string;
}

const {
  images = [],
  mainImageIndex = 0,
  showThumbnails = true,
  thumbnailCount = 4,
  className = "",
} = Astro.props;

const isEmpty = images.length === 0;

const validMainImageIndex = !isEmpty
  ? Math.max(0, Math.min(mainImageIndex, images.length - 1))
  : 0;

const thumbnailImages =
  !isEmpty && showThumbnails
    ? images
        .filter((_, index) => index !== validMainImageIndex)
        .slice(0, thumbnailCount)
    : [];

const mainImage = !isEmpty ? images[validMainImageIndex] : null;
---

{
  isEmpty ? (
    <p class={className}>No images to display</p>
  ) : (
    <div class={className}>
      {mainImage && (
        <div class="relative mb-4 bg-umbrella-surface rounded-lg overflow-hidden border border-umbrella-line">
          <Image
            src={`/Anthonyhf-Portfolio/images/${mainImage}`}
            alt={`Main image ${validMainImageIndex + 1}`}
            width={800}
            height={600}
            class="w-full h-auto object-cover transition-transform duration-300"
          />
          {/* Image counter */}
          {images.length > 1 && (
            <div class="absolute bottom-4 right-4 bg-black/50 text-white px-3 py-1 rounded text-sm backdrop-blur-sm">
              {validMainImageIndex + 1} / {images.length}
            </div>
          )}
        </div>
      )}

      {showThumbnails && thumbnailImages.length > 0 && (
        <div class="flex flex-wrap gap-2 -mb-2">
          {thumbnailImages.map((img, index) => {
            // Calculate actual index in the original images array
            const actualIndex = index < validMainImageIndex ? index : index + 1;

            return (
              <Image
                id={img}
                src={`/Anthonyhf-Portfolio/images/${img}`}
                alt={`Thumbnail ${actualIndex + 1}`}
                width={90}
                height={100}
                class="rounded-lg hover:scale-[1.05] transition-transform duration-200 border border-umbrella-line/50 hover:border-umbrella-green/50 cursor-pointer bg-umbrella-surface p-1"
              />
            );
          })}
        </div>
      )}
    </div>
  )
}
