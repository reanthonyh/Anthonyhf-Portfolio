---
import "@/styles/global.css";

interface Props {
  title: string;
  lang?: "en" | "es";
}

const { lang = "en", title } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="Anthonyhf-Portfolio/favicon.svg"
    />
    <link rel="icon" href="Anthonyhf-Portfolio/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
